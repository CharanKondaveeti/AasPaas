# No keys needed for browsing the bundled curated places and OpenFreeMap.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: never prefix this with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
APP_ORIGIN=http://localhost:3000
# Generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=
# Vercel: x-vercel-forwarded-for. Other hosts: only set a header your proxy overwrites.
# When blank, all submissions share a conservative 5/hour bucket.
TRUSTED_IP_HEADER=
