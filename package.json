    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "three": "0.180.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-postgis": "0.2.11",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.180.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.17",
